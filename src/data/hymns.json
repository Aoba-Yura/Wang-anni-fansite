    {
      "id": "bangs",
      "tabTitle": "刘海颂",
      "tabTitleJa": "前髪の賛歌",
      "date": "2026-09-09",
      "title": "刘海颂",
      "kind": "poem",
      "language": "zh-Hant",
      "paragraphs": [
        ["昔日額前大光明，", "光耀四方，燦然生輝。"],
        ["而今神蹟降臨——", "幾縷髮絲輕垂額前，", "如薄雲覆月，", "似細柳垂簾。"],
        ["我舉目觀看，見此景甚好。"],
        ["願微風只使它輕輕搖曳，", "願今日如此，明日如此，歲歲年年，亦復如此。"],
        ["願這溫柔的神蹟，", "長久停留於你的額前；", "願我每一次與你相見，", "都能再次見證它的降臨。"]
      ],
      "footerLabel": "作者",
      "footerText": "：曾经跟鲑鱼一起看蒋公逆流而上"
    }
  ]
